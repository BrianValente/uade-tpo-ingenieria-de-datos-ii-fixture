{
  "name": "fixture2030-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:lab": "node --env-file-if-exists=.env --import tsx scripts/run-integration.ts --serve",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . ../.github/workflows/hito-10-api.yml --check",
    "format:write": "prettier . ../.github/workflows/hito-10-api.yml --write",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "node --env-file-if-exists=.env --import tsx scripts/run-integration.ts",
    "test:writes": "node --env-file-if-exists=.env --import tsx scripts/run-integration.ts tests/integration/writes.test.ts",
    "measure:latency": "node --env-file-if-exists=.env --import tsx scripts/measure-latency.ts",
    "test:timeouts": "vitest run --config vitest.integration.config.ts tests/integration/timeouts.test.ts",
    "test:redis": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts tests/integration/redis-session.test.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:check": "tsx scripts/export-openapi.ts --check",
    "seed:users": "node --env-file-if-exists=.env --import tsx scripts/seed-users.ts",
    "env:local": "tsx scripts/setup-local-env.ts",
    "eval:conectividad": "node --env-file-if-exists=.env --import tsx ../hito-11-conectividad/scripts/evaluar_conectividad.ts",
    "eval:tcp": "node --env-file-if-exists=.env --import tsx ../hito-11-conectividad/scripts/prueba_tcp.ts",
    "eval:nativos": "node --env-file-if-exists=.env --import tsx ../hito-11-conectividad/scripts/prueba_clientes_nativos.ts",
    "eval:api": "node --env-file-if-exists=.env --import tsx ../hito-11-conectividad/scripts/prueba_api.ts",
    "validate": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:unit && pnpm build && pnpm openapi:check"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@intersystems/intersystems-iris-native": "2.0.3",
    "argon2": "0.45.1",
    "cassandra-driver": "4.10.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "mongodb": "7.7.0",
    "neo4j-driver": "6.2.0",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
