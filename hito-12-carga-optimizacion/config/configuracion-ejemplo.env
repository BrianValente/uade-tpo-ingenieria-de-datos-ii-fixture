# ==============================================================================
# Hito 12 — Plantilla de Configuración del Escenario de Carga y Optimización
# ==============================================================================
# IMPORTANTE (RNF8): Este archivo NO contiene secretos ni credenciales reales.
# La suite carga automáticamente las credenciales locales desde ../hito-10-api/.env
# y ../.env sin exponerlas en consola, logs ni reportes de evidencia.

# Endpoint HTTP de la API integrada bajo prueba
H12_API_HOST=127.0.0.1
H12_API_PORT=8012
H12_API_LOG_LEVEL=warn

# Parámetros reproducibles del escenario de carga (RF2, 5.2)
H12_CONCURRENCY=24
H12_WARMUP_SECONDS=3
H12_WARMUP_CONCURRENCY=4
H12_RAMPUP_SECONDS=4
H12_STEADY_SECONDS=12
H12_MAX_OPERATIONS=50000
H12_ABORT_ERROR_RATE=0.50
H12_REQUEST_TIMEOUT_MS=5000
DEPENDENCY_TIMEOUT_MS=3000
H12_SEED=203012

# Parámetros de datos de laboratorio y aislamiento (RF3, RNF7, RNF11)
H12_EXTRA_EVENTS_PER_MATCH=10
H12_VIRTUAL_SESSIONS=20
H12_REDIS_SCOPE=h12-bench

# Parámetros de la configuración Línea Base vs. Optimizada (RF4, RF8)
# Línea base: pool=5, cache=false, sessionThrottleSec=0
# Optimizada: pool=25, cache=true, cacheTtlTeamSec=300, cacheTtlMatchSec=120, cacheTtlEventsSec=15, sessionThrottleSec=60
H12_MONGO_POOL_SIZE_BASELINE=5
H12_NEO4J_POOL_SIZE_BASELINE=5
H12_MONGO_POOL_SIZE_OPTIMIZED=25
H12_NEO4J_POOL_SIZE_OPTIMIZED=25
H12_CACHE_TTL_TEAM_SECONDS=300
H12_CACHE_TTL_MATCH_SECONDS=120
H12_CACHE_TTL_EVENTS_SECONDS=15
H12_SESSION_RENEW_THROTTLE_SECONDS=60
