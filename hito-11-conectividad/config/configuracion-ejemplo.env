# ==============================================================================
# Hito 11 — Archivo de Configuración de Ejemplo (Sin Secretos)
# Fixture Mundial 2030 — Evaluación de Conectividad
# ==============================================================================
# Copie este archivo como .env en la raíz de hito-10-api o en este directorio:
# cp configuracion-ejemplo.env .env
# NUNCA suba contraseñas, tokens reales o URIs con credenciales al repositorio.
# ==============================================================================

# Entorno y Configuración de la API Integrada
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
API_REQUEST_TIMEOUT_MS=10000
API_BODY_LIMIT_BYTES=16384
DEPENDENCY_TIMEOUT_MS=2000

# 1. MongoDB (Módulo Documental / Cuentas)
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=fixture2030
MONGO_AUTH_SOURCE=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-mongo

# 2. Redis (Sesiones / Caché)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
API_REDIS_SCOPE=api

# 3. Neo4j (Módulo Grafos / Partidos)
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j

# 4. Apache Cassandra (Módulo Comentarios)
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=fixture2030_comentarios

# 5. InfluxDB 3 Core (Módulo Series Temporales)
INFLUXDB_HOST=127.0.0.1
INFLUXDB_PORT=8181
INFLUXDB_URL=http://127.0.0.1:8181
INFLUXDB_DATABASE=fixture2030_h8_lab_detalle
INFLUXDB_TOKEN=change-me-influx-token

# 6. InterSystems IRIS (Módulo Multimodelo / Objetos)
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_SUPERSERVER_PORT=1972
IRIS_WEB_PORT=52773
IRIS_NAMESPACE=USER
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS

# Semilla de Usuarios para Pruebas de API
API_SEED_ADMIN_PASSWORD=ejemplo-password-admin-largo-12345
API_SEED_USER_PASSWORD=ejemplo-password-user-largo-67890
